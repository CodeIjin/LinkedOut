# ========================================================
# LinkedOut Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECRETS LOCALLY
# NEVER COMMIT YOUR REAL .env FILE INTO VERSION CONTROL!
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Secrets (Minimum 32 random characters recommended)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min
ADMIN_API_KEY=admin_demo_secret_passphrase_change_in_production
ADMIN_EMAIL=admin_account@example.com
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# CORS Security (Allowed Client Origins - comma separated if multiple)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=15

# Session & Cookie Security
COOKIE_SECRET=change_this_cookie_signing_secret_random_token
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict

# Anonymity Shield Configuration
ANONYMIZATION_SALT=linkedout_whistleblower_salt_replace_in_prod
DEBUG=false
